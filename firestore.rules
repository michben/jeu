rules_version = '2';
// Règles de sécurité du jeu « Défis Concentré ».
// À coller dans Firebase → Firestore Database → Règles, puis « Publier ».
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    // Admin : email vérifié dans la liste, ou document admins/<uid> créé à la main dans la console Firebase.
    function isAdmin() {
      return signedIn() && (
        (request.auth.token.email_verified == true && request.auth.token.email in ['sospchs@gmail.com'])
        || exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    // Réglages du jeu (ouverture, modes, annonce, radio, sons) : lus par tous, modifiés par l'admin.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Profils publics (pseudo, ville, scores) : lus par les joueurs connectés, chacun écrit le sien.
    match /players/{uid} {
      allow read: if signedIn();
      allow write: if isSelf(uid) || isAdmin();
    }
    // Inscriptions (email de contact, newsletter) : visibles par le joueur lui-même et l'admin seulement.
    match /registrations/{uid} {
      allow read, write: if isSelf(uid) || isAdmin();
    }
    // Bibliothèque de « Sons à l'envers » : lue par les joueurs, gérée par l'admin.
    match /sounds/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /soundData/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    // Liste d'admins supplémentaires : gérée uniquement depuis la console Firebase.
    match /admins/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;
    }
  }
}
